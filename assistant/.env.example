# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Telegram ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram ID. Оставьте пустым при первом запуске — бот сам пришлёт ID в ответ на любое сообщение.
OWNER_ID=

# --- Claude (мозг) ---
# Ключ: https://console.anthropic.com → API Keys. Там же поставьте месячный лимит расходов.
ANTHROPIC_API_KEY=
# claude-opus-5-5 — самый умный ($4/$20 за 1M токенов)
# claude-sonnet-5-5 — в 2 раза дешевле ($2/$10)
# claude-haiku-5-5 — почти бесплатно ($0.10/$0.50), но проще в рассуждениях
CLAUDE_MODEL=claude-opus-5-5
# Глубина размышлений: low | medium | high | xhigh | max
CHAT_EFFORT=medium
PLANNING_EFFORT=high
ROLLUP_EFFORT=low
# Бот перестанет звать Claude, когда оценка расходов за месяц достигнет лимита (0 — без лимита).
MONTHLY_BUDGET_USD=30

# --- Распознавание речи (Whisper-совместимый API) ---
# Groq: https://console.groq.com/keys — быстро и дёшево (~$0.11 за час аудио)
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
STT_PRICE_PER_HOUR=0.111
# Альтернатива — OpenAI: STT_BASE_URL=https://api.openai.com/v1, STT_MODEL=gpt-4o-transcribe, STT_PRICE_PER_HOUR=0.36
STT_LANGUAGE=ru
# Словарь-подсказка: имена, бренды, термины, которые часто звучат в голосовых. Сильно улучшает распознавание.
STT_PROMPT=Kaspi, маржа, юнит-экономика, поставщик, предоплата, Alibaba, 1688, WeChat

# --- Озвучка ответов (edge-tts, бесплатно) ---
# Русские: ru-RU-DmitryNeural, ru-RU-SvetlanaNeural. Казахские: kk-KZ-DauletNeural, kk-KZ-AigulNeural
TTS_VOICE=ru-RU-DmitryNeural
TTS_RATE=+5%

# --- Распорядок ---
TIMEZONE=Asia/Almaty
MORNING_TIME=07:00
EVENING_TIME=21:30
WEEKLY_REVIEW=sun 20:00
ROLLUP_TIME=03:30

# Сферы жизни для задач и заметок (через запятую)
AREAS=work,project,family,health,faith,learning,finance,personal
# Сколько последних сообщений помнить дословно в каждом разговоре
HISTORY_MESSAGES=30
